<Window x:Class="PlayNow.Client.SpeedtestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speedtest" Icon="/app.ico" Height="400" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBackground}" CornerRadius="20" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTxt" Text="Тестирование скорости..." Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,15" 
                     Background="{DynamicResource PanelBackground}" 
                     Foreground="{DynamicResource TextPrimary}" 
                     BorderBrush="{DynamicResource ButtonBorder}"
                     BorderThickness="1"
                     FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Grid.Row="2" Content="ЗАКРЫТЬ" Height="40" Style="{StaticResource GlassBtn}" Tag="15" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>