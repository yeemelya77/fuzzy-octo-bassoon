<Window x:Class="PlayNow.Client.AppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор приложений" Icon="/app.ico" Height="650" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="24" Height="24" CornerRadius="6" 
                                    Background="{DynamicResource PanelBackground}" 
                                    BorderBrush="{DynamicResource ButtonBorder}" 
                                    BorderThickness="1" Margin="0,0,12,0">
                                <Path x:Name="tick" Visibility="Collapsed" Data="M 5,12 L 10,17 L 19,7" Stroke="#00CA71" StrokeThickness="3" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#00CA71"/>
                                <Setter TargetName="box" Property="Background" Value="#2000CA71"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource TextAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackground}" CornerRadius="20" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="🎮 Split Tunneling (Выбор игр)" Foreground="{DynamicResource TextAccent}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" 
                             Grid.Column="0" Padding="10,8" FontSize="16" 
                             Background="{DynamicResource PanelBackground}" 
                             Foreground="{DynamicResource TextPrimary}" 
                             BorderBrush="{DynamicResource ButtonBorder}" 
                             BorderThickness="1" Style="{x:Null}" Margin="0,0,77,0">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Content="📁 Файл" Style="{StaticResource GlassBtn}" Padding="15,0" Cursor="Hand" Click="AddCustomExe_Click" Margin="290,0,0,0"/>
                    <Button Grid.Column="1" Content="✍️ Процесс" Style="{StaticResource GlassBtn}" Padding="15,0" Cursor="Hand" Click="AddProcessManual_Click" Grid.ColumnSpan="3" Margin="5,0,0,-1" HorizontalAlignment="Left" Width="74"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="AppsContainer"/>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="СБРОСИТЬ" Height="50" FontSize="14" FontWeight="Bold" Style="{StaticResource GlassBtn}" Click="Reset_Click"/>
                <Button Grid.Column="2" Content="СОХРАНИТЬ ВЫБОР" Height="50" FontSize="16" FontWeight="Bold" Style="{StaticResource AccentBtn}" Click="Save_Click"/>
            </Grid>

            <Border x:Name="ProcessOverlay" Grid.RowSpan="3" Background="#F2000000" Visibility="Collapsed" CornerRadius="20">

                <Border Background="{DynamicResource PanelBackground}" CornerRadius="15" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="380" Height="480">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="⚙️ Запущенные программы" Foreground="{DynamicResource TextAccent}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выберите из списка или введите вручную:" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,-18,0,15" HorizontalAlignment="Center" FontSize="13"/>

                        <TextBox x:Name="ProcessSearchInput" TextChanged="ProcessSearchInput_TextChanged" Grid.Row="1" Padding="10" FontSize="14" Margin="0,0,0,10" 
                                 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ButtonBorder}">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <ListBox x:Name="ProcessListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,0,15"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Cursor="Hand" MouseLeftButtonUp="ProcessItem_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding ExeName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding WindowTitle}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ОТМЕНА" Grid.Column="0" Style="{StaticResource GlassBtn}" Height="40" Click="ProcessOverlayCancel_Click"/>
                            <Button Content="ДОБАВИТЬ ВВОД" Grid.Column="2" Style="{StaticResource AccentBtn}" Height="40" Click="ProcessOverlayAdd_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>